# Copy this file to .env and fill in the values. .env is git-ignored and must never be committed.
# Node reads .env when the service starts (npm start), so the settings persist between shells.
# On a hosted service, set these in the host's environment instead; do not deploy a .env file.

# Which connector to run: razorpay
PARMANA_CONNECTOR=razorpay

# Razorpay credential, "<key id>:<key secret>". Use a rzp_test_ key unless live use is approved.
RAZORPAY_KEY_PAIR=
# Paytm (paytm connector, staging only): "<merchant id>:<merchant key>". The key must be exactly 16 bytes.
PAYTM_MERCHANT_CREDENTIAL=
# GitHub App (github connector): "<app id>:<installation id>:<base64 of the PEM private key>".
GITHUB_APP_CREDENTIAL=
# HubSpot (hubspot connector): a Private App token.
HUBSPOT_PRIVATE_APP_TOKEN=
# Slack (slack connector): a bot token, xoxb-..., with the chat:write scope.
SLACK_BOT_TOKEN=
# Zoho Books (zoho connector): an OAuth access token, and the organization id (digits only).
ZOHO_ACCESS_TOKEN=
ZOHO_ORGANIZATION_ID=

# Set to true only when live use is approved. Leave false for test keys.
PARMANA_ALLOW_LIVE_KEYS=false

# Parmana's Ed25519 public key. Set either the PEM text or a file path, never both.
PARMANA_PUBLIC_KEY=
PARMANA_PUBLIC_KEY_FILE=

# This endpoint's URL, exactly as registered in parmana-core. Must be https.
PARMANA_RELEASE_AUDIENCE=

# Replay protection. postgres is required for more than one instance.
PARMANA_RELEASE_LEDGER=postgres
PARMANA_DATABASE_URL=

# Optional
PARMANA_SERVICE_PORT=8080
PARMANA_SERVICE_HOST=127.0.0.1
# The time limit for a connector's calls. For Razorpay it covers all the calls for one release together.
PARMANA_CONNECTOR_TIMEOUT_MS=10000

# Used only by scripts/razorpay-test-run.mjs
RAZORPAY_TEST_PAYMENT_ID=
RAZORPAY_TEST_AMOUNT=100
