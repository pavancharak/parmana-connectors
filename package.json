{
  "name": "parmana-connectors",
  "version": "0.0.0",
  "private": true,
  "description": "Vendor connectors for Parmana. Each runs as an external connector service and receives signed releases from parmana-core.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "check:config": "tsc -p tsconfig.json && node --env-file-if-exists=.env dist/service/check-config-cli.js"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@parmana/crypto": "0.1.1",
    "ajv": "^8.20.0",
    "dotenv": "^18.0.9",
    "pg": "^8.23.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "zod": "4.6.6"
  }
}
