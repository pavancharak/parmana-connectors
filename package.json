    "start": "node dist/main.js"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@parmana/crypto": "0.1.0",
    "ajv": "^8.20.0",
    "dotenv": "^18.0.9",
    "pg": "^8.23.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
