{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parmana.dev/schema/connect-manifest.json",
  "title": "parmana-connect manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["system", "baseUrl", "apiVersion", "credential", "capabilities"],
  "properties": {
    "system": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,40}$"
    },
    "baseUrl": {
      "type": "string",
      "minLength": 8,
      "maxLength": 2048
    },
    "apiVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "credential": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "secretRef"],
      "properties": {
        "type": {
          "enum": ["bearer", "header"]
        },
        "headerName": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9-]{0,63}$"
        },
        "secretRef": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,127}$"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "header" } }, "required": ["type"] },
          "then": {
            "required": ["headerName"],
            "properties": { "headerName": { "type": "string" } }
          }
        }
      ]
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "method", "path", "effect"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$"
          },
          "method": {
            "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]
          },
          "path": {
            "type": "string",
            "pattern": "^/[^?#\\s]*$",
            "maxLength": 512
          },
          "effect": {
            "enum": ["read", "write"]
          },
          "input": {
            "type": "object",
            "additionalProperties": false,
            "maxProperties": 50,
            "patternProperties": {
              "^[a-zA-Z][a-zA-Z0-9_]{0,63}$": {
                "type": "object",
                "additionalProperties": false,
                "required": ["type"],
                "properties": {
                  "type": {
                    "enum": ["string", "number", "integer", "boolean", "object", "array"]
                  },
                  "required": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
