# No-bypass probe settings for partner org A.
# Copy to a private env file and fill in. Do not commit real values.
# The probe sends a request with no approval to the route below and expects it to be refused.

# Name shown in probe records.
BYPASS_PROBE_TARGET_NAME=partner-org-a-refund-route

# The partner's refund route, as an https URL. Not known yet.
BYPASS_PROBE_TARGET_URL=https://PARTNER-REFUND-ROUTE-NOT-YET-SHARED

# GET or POST. Use the method the refund route accepts.
BYPASS_PROBE_METHOD=POST

# Body sent with the probe. Must not carry an approval.
BYPASS_PROBE_BODY={"paymentId":"pay_PROBE000000","amountInr":1}

# Parmana's private key used to sign probe records (PEM). Keep out of source control.
BYPASS_PROBE_SIGNING_KEY_PEM=
